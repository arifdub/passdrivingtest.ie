# ===========================================================================
# ENVIRONMENT VARIABLES
#
# Copy to .env.local for local development. Real values live in Vercel's
# dashboard (Settings -> Environment Variables), never in this repository.
#
# THESE TWO ARE THE WHOLE LIST.
#
# The app reads exactly two variables, both in src/supabaseClient.js, and
# nothing else — no process.env anywhere in src/. If something isn't working,
# adding more variables is not the fix.
#
#   grep -rno "import\.meta\.env\.[A-Za-z_]*" src/
#
# will always tell you the current truth, which is what this file is a copy of.
# ===========================================================================

# Supabase -> Project Settings -> API -> Project URL
# Format: https://<20-lowercase-letters>.supabase.co  — no trailing slash.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API Keys -> Publishable key
#
# The variable is still called ANON_KEY because that is what the code reads
# (src/supabaseClient.js); Supabase renamed the thing, not us. A project
# created recently issues "publishable" keys that start with sb_publishable_
# rather than the older anon key, which was a JWT starting with eyJ. Either
# works with @supabase/supabase-js 2.117+; the publishable one is current.
#
# NOT the secret key. sb_secret_ bypasses row-level security, and every
# VITE_ value is compiled into the bundle each visitor downloads, so putting
# it here would publish full access to the database.
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here


# ---------------------------------------------------------------------------
# WHY NEITHER OF THESE IS A SECRET, AND SHOULD NOT BE STORED AS ONE
#
# Vite inlines every VITE_* variable into the JavaScript bundle at BUILD time.
# Both values are therefore in a file that every visitor downloads. That is
# how any browser client works, and it is why the anon key is called anon:
# it identifies the project, it does not authorise anything. What protects
# the data is row-level security, enforced in Postgres — see the policies in
# sql/.
#
# Storing them as Vercel "Secret" type variables buys no security at all, and
# costs you the ability to read the value back when you need to check it.
# Use the plain "Config" type.
#
# The key that IS a secret is the service-role key. It bypasses row-level
# security entirely. It is not used by this app and must never appear in a
# VITE_* variable, because that would publish it.
#
# ---------------------------------------------------------------------------
# A CHANGE HERE NEEDS A REDEPLOY
#
# Because these are inlined at build time, editing them in Vercel changes
# nothing until a new build runs. Changing a value and reloading the site
# will show you the old one.
# ---------------------------------------------------------------------------
