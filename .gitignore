# Build output and dependencies — the README always claimed these were
# ignored, but no .gitignore was ever committed, so every `npm install` left
# 300MB of untracked noise in `git status`.
node_modules/
dist/
dist-ssr/

# Local environment. Real values live in Vercel's dashboard, never in the
# repository — see src/supabaseClient.js.
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
*.local
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
_preview/dist
